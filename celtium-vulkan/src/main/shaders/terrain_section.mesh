#version 450
#extension GL_EXT_mesh_shader : require

// ============================================================================================
// Celtium - native Vulkan terrain renderer - SOLID pass - MESH stage (item 677, stage 3).
//
// The mesh side of the stage-2/3 task+mesh terrain path: the sibling of terrain_solid.mesh
// (stage 1) fed not by indirect draw records but by the section task shader
// (terrain_section.task). One task workgroup survives per visible section and emits up to
// QUADS_PER_WORKGROUP mesh workgroups for it; each mesh workgroup re-issues its slice of
// the section's quads - at most 42 quads, 252 vertices, 84 primitives, inside RADV's
// measured mesh output limits (maxMeshOutputVertices / maxMeshOutputPrimitives = 256,
// mesh-shader-652 section 1.1) - reading the section's DrawSourceTable entries, the shared
// vertex arena and the entry's index buffer as storage buffers, and emitting exactly the
// triangles the indexed path would read for those quads. The fragment stage is the pass'
// own terrain_solid.frag; the per-vertex computation is terrain_solid.mesh's emitVertex
// carried over unchanged (the same COMPACT unpack, region offset, lightmap sample, dynamic
// raise and shadow colour), so the two mesh forms cannot drift apart in what they compute
// for a vertex. Two substitutions against stage 1: gl_InstanceIndex is the payload's
// frameIndex (the remap's binding-5 answer, carried task -> mesh because the mesh stage
// has no firstInstance of its own - design section 8.2), and the matrices arrive in a
// uniform block instead of push constants, because the push block of this pipeline belongs
// to the task stage (terrain_section.task's 144-byte culling block occupies offset 0).
//
// --------------------------------------------------------------------------------------------
// RESOURCE DESIGN
// --------------------------------------------------------------------------------------------
//   TASK PAYLOAD (written by terrain_section.task, read here):
//       int  frameIndex       the section's binding-5 region index for this frame
//       uint firstEntry       first table entry of the section (absolute, entry base incl.)
//       uint entryCount       entries in the section's run
//       uint taskWorkGroupX   the issuing task workgroup's gl_WorkGroupID.x
//       uint sectionIndex     the section's directory index
//     This workgroup's split position inside the section is
//     gl_WorkGroupID.x - taskWorkGroupX (design section 2.2 of the stage-2 prep record:
//     mesh workgroup ids are the task workgroup's id plus the in-group offset).
//
//   DESCRIPTOR SET 0: the task-private set owned by VulkanMeshTaskDraw. Only binding 1
//   (the DrawSourceTable) is declared here; its layout carries TASK | MESH stage flags for
//   that binding so the same set serves both stages.
//
//   DESCRIPTOR SET 1: the terrain pass' own set, identical declarations to
//   terrain_solid.mesh's set 0 (binding 0 the solid uniforms, binding 1 the light map,
//   binding 3 the dynamic light block, binding 5 the per-region offsets). The set itself
//   is the pass' own, bound by the caller exactly as for the vertex path.
//
//   DESCRIPTOR SET 2 (this path only, MESH stage):
//     binding 0 : storage buffer "CeltiumVertexArena" - the shared vertex arena as uint
//                 words; one COMPACT vertex is 6 words (24 bytes).
//     binding 1 : storage buffer "CeltiumIndexArena" - the index buffer the section's
//                 entries read, as uint indices. Which buffer this is follows the entry
//                 flags' index-source bit (bit 0: the region's own index arena; 0: the
//                 shared quad index buffer) - the caller binds the buffer the entries of
//                 the pass name, exactly as the indirect path binds it for the draw.
//     binding 2 : uniform block "CeltiumMeshFrame" - the pass' projection and model-view
//                 matrices (the vertex stage's push block, carried in a buffer here; see
//                 the header for why push is the task stage's).
//
//   SPLIT BUDGET: QUADS_PER_WORKGROUP is a compile-time constant on purpose in this first
//   form and MUST equal VulkanMeshTaskDraw.QUADS_PER_MESH_WORKGROUP's default (42): the
//   task stage takes its budget from push, this stage cannot read the task push block, and
//   VulkanMeshStage2Pipeline refuses to create a pipeline while the two disagree (the
//   system property override is rejected there, counted, not silently mismatched).
// ============================================================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 256, max_primitives = 128) out;

const uint TASK_WORKGROUP_SIZE = 32u;
const uint QUADS_PER_WORKGROUP = 64u;

// --------------------------------------------------------------------------------------------
// Task payload - the declaration is terrain_section.task's, word for word.
// --------------------------------------------------------------------------------------------
struct CeltiumSectionTaskPayload {
    uint sectionCount;
    uint meshletEnd[TASK_WORKGROUP_SIZE];
    int  frameIndex[TASK_WORKGROUP_SIZE];
    uint firstEntry[TASK_WORKGROUP_SIZE];
    uint entryCount[TASK_WORKGROUP_SIZE];
    uint sectionQuads[TASK_WORKGROUP_SIZE];
};

taskPayloadSharedEXT CeltiumSectionTaskPayload celtiumPayload;

// --------------------------------------------------------------------------------------------
// Descriptor set 0, binding 1 - the DrawSourceTable (32-byte entries, std430 words):
//   word 0 indexCount, 1 firstIndex, 2 vertexOffset, 3 dictIndex,
//   word 4..6 section x/y/z, 7 flags (bit 0 index source, bits 8..15 pass ordinal).
// --------------------------------------------------------------------------------------------
layout(set = 0, binding = 1, std430) readonly buffer DrawSourceTable {
    uint tableData[];
};

// --------------------------------------------------------------------------------------------
// Descriptor set 1 - declarations identical to terrain_solid.mesh's set 0.
// --------------------------------------------------------------------------------------------
layout(std140, set = 1, binding = 0) uniform CeltiumSolidUniforms {
    vec4  u_RegionOffset;           // offset  0
    vec4  u_FogColor;               // offset 16
    float u_FogDensity;             // offset 32
    float u_FogStart;               // offset 36
    float u_FogEnd;                 // offset 40
    float u_MipBiasAdd;             // offset 44
    int   u_FogMode;                // offset 48
    int   u_FogShape;               // offset 52
    int   u_FragmentDiscardEnabled; // offset 56
    int   u_ChunkFadeEnabled;       // offset 60
    vec4  u_ChunkFadeParams;        // offset 64
    int   u_SolidTerrain;           // offset 80 (fragment stage only)
    int   u_ShadowEnabled;          // offset 84 item 537
    float u_ShadowDarkness;         // offset 88
    mat4  u_ShadowMatrix;           // offset 96
} celtium;

layout(std430, set = 1, binding = 5) readonly buffer CeltiumRegionOffsets {
    vec4 u_RegionOffsets[];
};

layout(set = 1, binding = 1) uniform sampler2D u_LightTex;

layout(std140, set = 1, binding = 3) uniform CeltiumDynamicLights {
    vec4 u_DynamicLightInfo;  // offset  0: x = live source count (0..32), yzw = camera position (world)
    vec4 u_DynamicLights[32]; // offset 16: xyz = camera-relative position, w = light level 0..15
} dynLights;

// --------------------------------------------------------------------------------------------
// Descriptor set 2 - this path's own inputs (see the design block).
// --------------------------------------------------------------------------------------------
layout(std430, set = 2, binding = 0) readonly buffer CeltiumVertexArena {
    uint u_VertexWords[];
};

layout(std430, set = 2, binding = 1) readonly buffer CeltiumIndexArena {
    uint u_Indices[];
};

layout(std140, set = 2, binding = 2) uniform CeltiumMeshFrame {
    mat4 u_ProjectionMatrix; // offset  0
    mat4 u_ModelViewMatrix;  // offset 64
} frame;

// --------------------------------------------------------------------------------------------
// Varyings - per-vertex outputs; locations and types match terrain_solid.frag's inputs
// and terrain_solid.mesh's outputs. Sized for the full split budget (64 quads x 4 vertices).
// --------------------------------------------------------------------------------------------
layout(location = 0) out vec4 v_Color[256];
layout(location = 1) out vec4 v_RdhFactor[256];
layout(location = 2) out vec2 v_QuadCoord[256];
layout(location = 3) out vec2 v_TexCoord[256];
layout(location = 4) out float v_FragDistance[256];
layout(location = 5) flat out float v_MaterialMipBias[256];
layout(location = 6) flat out float v_MaterialAlphaCutoff[256];
layout(location = 7) out vec4 v_ShadowPos[256];
layout(location = 8) out vec4 v_ShadowColor[256];

// --------------------------------------------------------------------------------------------
// Helpers - verbatim from terrain_solid.mesh (which took them verbatim from
// terrain_solid.vert), so the vertex computation cannot drift between the mesh forms.
// --------------------------------------------------------------------------------------------
const float VERT_POS_SCALE = 32.0 / 2097152.0; // exact power of two: 2^-16
const float VERT_POS_OFFSET = -8.0;
const float VERT_TEX_SCALE = 1.0 / 131072.0;   // exact power of two: 2^-17

uvec3 _get_relative_chunk_coord(uint pos) {
    // Packing scheme is defined by LocalSectionIndex
    return uvec3(pos) >> uvec3(5u, 0u, 2u) & uvec3(7u, 3u, 7u);
}

vec3 _get_draw_translation(uint pos) {
    return _get_relative_chunk_coord(pos) * vec3(16.0);
}

const uint MATERIAL_USE_MIP_OFFSET = 0u;
const uint MATERIAL_ALPHA_CUTOFF_OFFSET = 1u;

const float[4] ALPHA_CUTOFF = float[4](0.0, 0.1, 0.5, 1.0);

float _material_mip_bias(uint material) {
    return ((material >> MATERIAL_USE_MIP_OFFSET) & 1u) != 0u ? 0.0 : -4.0;
}

float _material_alpha_cutoff(uint material) {
    return ALPHA_CUTOFF[(material >> MATERIAL_ALPHA_CUTOFF_OFFSET) & 3u];
}

const int FOG_SHAPE_SPHERICAL = 0;
const int FOG_SHAPE_CYLINDRICAL = 1;
const int FOG_SHAPE_PLANAR = 2;

float getFragDistance(int fogShape, vec3 position) {
    // Use the maximum of the horizontal and vertical distance to get cylindrical fog if fog shape is cylindrical
    if (fogShape == FOG_SHAPE_CYLINDRICAL) {
        return max(length(position.xz), abs(position.y));
    } else {
        return length(position);
    }
}

vec4 _sample_lightmap(sampler2D lightMap, vec2 uv) {
    // The vertex stage's texture() at LOD 0, written explicitly: a mesh stage has no implicit
    // derivatives, and the half-texel centre expression is the vertex stage's own (see the
    // comment there for why (uv + 8) / 256 with the 16-texel clamp is the right centre).
    return textureLod(lightMap, clamp((vec2(uv) + 8.0) / 256.0, vec2(0.5 / 16.0), vec2(15.5 / 16.0)), 0.0);
}

float _dynamic_block_light(vec3 position) {
    float level = 0.0;
    int count = int(dynLights.u_DynamicLightInfo.x + 0.5);
    // Both the sources and this vertex's position are camera-relative, so the position is used
    // as-is (the vertex stage's comment on item 430 covers why the header camera is not
    // subtracted a second time).
    vec3 relativePosition = position;
    for (int i = 0; i < 32; i++) {
        if (i >= count) {
            break;
        }
        vec4 source = dynLights.u_DynamicLights[i];
        level = max(level, source.w - distance(relativePosition, source.xyz));
    }
    return level;
}

// --------------------------------------------------------------------------------------------
// One vertex, computed exactly as terrain_solid.mesh's emitVertex computes it, from the
// arena words of the 24-byte COMPACT vertex (see that shader for the word layout). The
// only differences: the matrices come from the frame block, and firstInstance is the
// payload's frameIndex.
// --------------------------------------------------------------------------------------------
void emitVertex(int slot, uint vertexId, uint firstInstance) {
    uint base = vertexId * 6u;
    uvec4 a_PosId = uvec4(
            u_VertexWords[base + 0u] & 0xFFFFu, u_VertexWords[base + 0u] >> 16u,
            u_VertexWords[base + 1u] & 0xFFFFu, u_VertexWords[base + 1u] >> 16u);
    vec4 a_Color = unpackUnorm4x8(u_VertexWords[base + 2u]);
    uvec2 a_TexCoord = uvec2(
            u_VertexWords[base + 3u] & 0xFFFFu, u_VertexWords[base + 3u] >> 16u);
    uint a_LightCoord = u_VertexWords[base + 4u];
    vec4 a_RdhFactor = unpackSnorm4x8(u_VertexWords[base + 5u]);

    // ---- _vert_init(), USE_VERTEX_COMPRESSION branch (terrain_solid.vert, verbatim) --------
    uint packed_draw_params = (a_LightCoord & 0xFFFFu);

    uvec3 position = (a_PosId.xyz << 5u) | ((uvec3(a_PosId.w) >> uvec3(0u, 5u, 10u)) & uvec3(0x1Fu));
    uvec2 tex_coord = (a_TexCoord << 2u) | ((uvec2(packed_draw_params) >> uvec2(4u, 6u)) & uvec2(0x3u));

    vec3 _vert_position = (vec3(position) * VERT_POS_SCALE + VERT_POS_OFFSET);
    vec2 _vert_tex_diffuse_coord = (vec2(tex_coord) * VERT_TEX_SCALE);
    vec4 _vert_color = a_Color;
    vec4 _vert_rdh_factor = a_RdhFactor;

    uint _material_params = (packed_draw_params) & 0xFu;
    uint _draw_id = (packed_draw_params >> 8) & 0xFFu;
    ivec2 _vert_tex_light_coord = ivec2((uvec2((a_LightCoord >> 16) & 0xFFFFu) >> uvec2(0u, 8u)) & uvec2(0xFFu));

    // ---- main() (terrain_solid.vert, with firstInstance for gl_InstanceIndex) --------------
    vec3 translation = u_RegionOffsets[firstInstance].xyz + _get_draw_translation(_draw_id);
    vec3 worldPosition = _vert_position + translation;

    v_FragDistance[slot] = getFragDistance(celtium.u_FogShape, worldPosition);

    gl_MeshVerticesEXT[slot].gl_Position =
            frame.u_ProjectionMatrix * frame.u_ModelViewMatrix * vec4(worldPosition, 1.0);

    v_RdhFactor[slot] = _vert_rdh_factor * 2.0;
    vec2 lightCoord = vec2(_vert_tex_light_coord);
    float dynamicLevel = _dynamic_block_light(worldPosition);
    if (dynamicLevel > 0.0) {
        lightCoord.x = max(lightCoord.x, min(dynamicLevel, 15.0) * 16.0);
    }
    vec4 lightColor = _sample_lightmap(u_LightTex, lightCoord);
    v_Color[slot] = _vert_color * lightColor;
    if (celtium.u_ShadowEnabled != 0) {
        v_ShadowPos[slot] = celtium.u_ShadowMatrix * vec4(worldPosition, 1.0);
        vec2 shadowedCoord = vec2(lightCoord.x, lightCoord.y * (1.0 - celtium.u_ShadowDarkness));
        v_ShadowColor[slot] = _vert_color * _sample_lightmap(u_LightTex, shadowedCoord);
    } else {
        v_ShadowPos[slot] = vec4(0.0);
        v_ShadowColor[slot] = v_Color[slot];
    }
    v_RdhFactor[slot].rgb *= lightColor.rgb;

    // The vertex stage's corner selector is gl_VertexIndex & 3; the id here is the same value
    // (the index buffer's entry for this corner, plus the entry's vertex offset).
    int corner = int(vertexId) & 3;
    v_QuadCoord[slot] = vec2(corner >= 2 ? 1.0 : 0.0,
            corner == 1 || corner == 2 ? 1.0 : 0.0);
    v_TexCoord[slot] = _vert_tex_diffuse_coord;

    v_MaterialMipBias[slot] = _material_mip_bias(_material_params) + celtium.u_MipBiasAdd;
    v_MaterialAlphaCutoff[slot] = _material_alpha_cutoff(_material_params);
}

void main() {
    // gl_WorkGroupID.x is 0-based within the grid emitted by EmitMeshTasksEXT for this
    // 32-section tile. Binary-search the inclusive meshlet prefix sum to locate the
    // surviving section and its 0-based splitIndex; all 64 lanes execute uniformly.
    uint meshletId = gl_WorkGroupID.x;
    uint count = celtiumPayload.sectionCount;
    uint lo = 0u;
    uint hi = count;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1u;
        if (celtiumPayload.meshletEnd[mid] <= meshletId) {
            lo = mid + 1u;
        } else {
            hi = mid;
        }
    }
    if (lo >= count) {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    uint prevEnd = (lo == 0u) ? 0u : celtiumPayload.meshletEnd[lo - 1u];
    uint splitIndex = meshletId - prevEnd;
    uint quadStart = splitIndex * QUADS_PER_WORKGROUP;
    uint sectionQuads = celtiumPayload.sectionQuads[lo];
    uint emitted = 0u;
    if (quadStart < sectionQuads) {
        emitted = min(QUADS_PER_WORKGROUP, sectionQuads - quadStart);
    }
    SetMeshOutputsEXT(emitted * 4u, emitted * 2u);
    uint q = gl_LocalInvocationID.x;
    if (q >= emitted) {
        return;
    }

    // One lane per quad: locate the DrawSourceTable entry covering quad (quadStart + q)
    // and emit its 4 shared vertices + 2 triangles in parallel across the 64-lane workgroup.
    uint firstEntry = celtiumPayload.firstEntry[lo];
    uint entryEnd = firstEntry + celtiumPayload.entryCount[lo];
    uint firstInstance = uint(celtiumPayload.frameIndex[lo]);
    uint quad = quadStart + q;

    uint entryIndex = firstEntry;
    uint entryQuadBase = 0u;
    while (entryIndex + 1u < entryEnd) {
        uint eQuads = tableData[entryIndex * 8u + 0u] / 6u;
        if (quad < entryQuadBase + eQuads) {
            break;
        }
        entryQuadBase += eQuads;
        entryIndex++;
    }

    uint wordBase = entryIndex * 8u;
    uint firstIndex = tableData[wordBase + 1u];
    uint vertexOffset = tableData[wordBase + 2u];
    uint entryFlags = tableData[wordBase + 7u];
    uint localQuad = quad - entryQuadBase;

    uint outVertex = q * 4u;
    uint outPrimitive = q * 2u;
    int slotBase = int(outVertex);
    if (firstIndex == 0u && (entryFlags & 1u) == 0u) {
        // Shared unsorted quad index pattern (QuadPrimitiveType: 0,1,2, 2,3,0):
        // emit the 4 unique quad corners directly without reading the index buffer.
        uint vertexBase = vertexOffset + localQuad * 4u;
        emitVertex(slotBase + 0, vertexBase + 0u, firstInstance);
        emitVertex(slotBase + 1, vertexBase + 1u, firstInstance);
        emitVertex(slotBase + 2, vertexBase + 2u, firstInstance);
        emitVertex(slotBase + 3, vertexBase + 3u, firstInstance);
    } else {
        uint indexBase = firstIndex + localQuad * 6u;
        emitVertex(slotBase + 0, u_Indices[indexBase + 0u] + vertexOffset, firstInstance);
        emitVertex(slotBase + 1, u_Indices[indexBase + 1u] + vertexOffset, firstInstance);
        emitVertex(slotBase + 2, u_Indices[indexBase + 2u] + vertexOffset, firstInstance);
        emitVertex(slotBase + 3, u_Indices[indexBase + 4u] + vertexOffset, firstInstance);
    }
    gl_PrimitiveTriangleIndicesEXT[outPrimitive] =
            uvec3(outVertex, outVertex + 1u, outVertex + 2u);
    gl_PrimitiveTriangleIndicesEXT[outPrimitive + 1u] =
            uvec3(outVertex + 2u, outVertex + 3u, outVertex);
}
