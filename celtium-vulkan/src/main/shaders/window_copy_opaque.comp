#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) writeonly uniform image2D pixels;
layout(set = 0, binding = 1) uniform sampler2D sourceImage;
layout(push_constant) uniform Rectangle { ivec2 origin; ivec2 extent; } rectangle;

void main() {
    ivec2 point = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(point, rectangle.extent))) return;
    vec4 color = texelFetch(sourceImage, rectangle.origin + point, 0);
    imageStore(pixels, point, vec4(color.rgb, 1.0));
}
