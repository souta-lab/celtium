#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

#include "terrain_cull.glsl"

// E10 / item 677, mesh stage 5 (Wave32 task-shader amplification): 32 sections per task
// workgroup (one RDNA 2 Wave32 wavefront, 100% SIMD utilization vs 1/32 in stage 2). Each
// lane applies the same deterministic judgement chain as the compute generation (design
// section 2.4, plan H: occlusion mask AND remap AND frustum AND distance; the frustum and
// distance formulas are the shared fragment in terrain_cull.glsl, never a second copy).
// Surviving sections are compacted in deterministic slot order into workgroup-local shared
// memory and published into the task payload with an inclusive meshlet prefix sum (zero
// global atomics, no count-buffer reproduction). One EmitMeshTasksEXT dispatches all
// meshlets for the 32-section tile (zero mesh workgroups when the whole tile is culled).

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

const uint TASK_WORKGROUP_SIZE = 32u;

// Task-private set 0 (design section 2.2): the directory first, then the same three
// inputs the compute generation reads. The layout is owned by VulkanMeshTaskDraw.
layout(set = 0, binding = 0, std430) readonly buffer SectionDirectory {
    uint directoryData[];
};
layout(set = 0, binding = 1, std430) readonly buffer DrawSourceTable {
    uint tableData[];
};
layout(set = 0, binding = 2, std430) readonly buffer RegionRemap {
    int remapData[];
};
layout(set = 0, binding = 3, std430) readonly buffer OcclusionMask {
    uint maskData[];
};

// The 144-byte push block of the terrain generation family: terrain_cull.comp carries
// the same first 112 bytes (frustum planes, then the camera vec4 whose w is the maximum
// distance). params: x = pass ordinal, y = section count, z = quads per mesh workgroup
// (the split budget), w = remap base. params2: x = table entry base (entries), y = mask
// base (words), z/w unused in the task stage.
layout(push_constant) uniform Push {
    vec4 planes[6];
    vec4 camera;
    ivec4 params;
    ivec4 params2;
} push;

// Compacted tile payload (644 bytes, well within VK_EXT_mesh_shader's 16 KB minimum):
// meshletEnd[i] is the inclusive meshlet prefix sum for surviving section i, so a mesh
// workgroup with gl_WorkGroupID.x in [0, totalMeshlets) locates its section by binary
// search and recovers its 0-based splitIndex as gl_WorkGroupID.x - prevEnd.
struct CeltiumSectionTaskPayload {
    uint sectionCount;
    uint meshletEnd[TASK_WORKGROUP_SIZE];
    int  frameIndex[TASK_WORKGROUP_SIZE];
    uint firstEntry[TASK_WORKGROUP_SIZE];
    uint entryCount[TASK_WORKGROUP_SIZE];
    uint sectionQuads[TASK_WORKGROUP_SIZE];
};

taskPayloadSharedEXT CeltiumSectionTaskPayload celtiumPayload;

shared uint s_survives[TASK_WORKGROUP_SIZE];
shared int  s_frameIndex[TASK_WORKGROUP_SIZE];
shared uint s_firstEntry[TASK_WORKGROUP_SIZE];
shared uint s_entryCount[TASK_WORKGROUP_SIZE];
shared uint s_sectionQuads[TASK_WORKGROUP_SIZE];
shared uint s_meshlets[TASK_WORKGROUP_SIZE];
shared uint s_totalMeshlets;

// The mask segment always opens with a six-word header (window base xyz, dims xyz) —
// the unified layout of the E10-b mask supply, so the form is decidable without a push
// change. dims == 0 selects the dictionary form (a bitset over dictionary indices after
// the header); dims > 0 selects the lattice form, whose bit index is the SectionLattice
// slot of the section coordinate: the same interior test and the same
// (lx * dimZ + lz) * dimY + ly formula as SectionLattice.indexOf, which the Java mask
// resolution also mirrors.
bool celtiumMaskAllows(uint dictIndex, ivec3 section) {
    int base = push.params2.y;
    ivec3 windowBase = ivec3(int(maskData[base + 0]), int(maskData[base + 1]),
            int(maskData[base + 2]));
    ivec3 dims = ivec3(int(maskData[base + 3]), int(maskData[base + 4]),
            int(maskData[base + 5]));
    uint bit;
    if (dims == ivec3(0)) {
        bit = dictIndex;
    } else {
        ivec3 local = section - windowBase;
        if (local.x < 1 || local.x > dims.x - 2
                || local.y < 1 || local.y > dims.y - 2
                || local.z < 1 || local.z > dims.z - 2) {
            return false;
        }
        bit = uint((local.x * dims.z + local.z) * dims.y + local.y);
    }
    uint word = maskData[base + 6 + int(bit >> 5u)];
    return (word & (1u << (bit & 31u))) != 0u;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint sectionIndex = gl_WorkGroupID.x * TASK_WORKGROUP_SIZE + lid;
    uint survives = 0u;
    int outFrameIndex = -1;
    uint outFirstEntry = 0u;
    uint outEntryCount = 0u;
    uint outQuads = 0u;
    uint outMeshlets = 0u;

    if (sectionIndex < uint(push.params.y)) {
        uint dirBase = sectionIndex * 8u;
        ivec3 section = ivec3(int(directoryData[dirBase + 0u]),
                int(directoryData[dirBase + 1u]), int(directoryData[dirBase + 2u]));
        int dictIndex = int(directoryData[dirBase + 3u]);
        uint firstEntry = directoryData[dirBase + 4u];
        uint entryCount = directoryData[dirBase + 5u];
        uint totalIndexCount = directoryData[dirBase + 6u];
        uint dirFlags = directoryData[dirBase + 7u];
        // Directory-local ineligibility bits (SectionDirectory: bit 17 non-quad entry,
        // bit 18 mixed dictionary index). The CPU gate already refuses to arm the pass
        // while such a section exists, so this is the second line of the same defence.
        bool eligible = (dirFlags & 0x60000u) == 0u && dictIndex >= 0;
        if (eligible && celtiumMaskAllows(uint(dictIndex), section)) {
            int frameIndex = remapData[push.params.w + dictIndex];
            if (frameIndex >= 0) {
                // The run's first entry must belong to this pass and carry a section
                // box; the directory is built per pass from the same table, so a
                // mismatch means the inputs disagree and nothing may be emitted.
                uint entryBase = (uint(push.params2.x) + firstEntry) * 8u;
                uint entryFlags = tableData[entryBase + 7u];
                bool sectionBox = (entryFlags & 2u) != 0u;
                bool thisPass = int((entryFlags >> 8u) & 0xFFu) == push.params.x;
                vec3 boxMin = vec3(section * 16);
                if (sectionBox && thisPass && celtiumBoxVisible(boxMin, vec3(16.0),
                        push.planes, push.camera.xyz, push.camera.w)) {
                    uint quads = totalIndexCount / 6u;
                    uint budget = uint(max(push.params.z, 1));
                    uint split = (quads + budget - 1u) / budget;
                    if (split > 0u) {
                        survives = 1u;
                        outFrameIndex = frameIndex;
                        outFirstEntry = firstEntry + uint(push.params2.x);
                        outEntryCount = entryCount;
                        outQuads = quads;
                        outMeshlets = split;
                    }
                }
            }
        }
    }

    s_survives[lid] = survives;
    s_frameIndex[lid] = outFrameIndex;
    s_firstEntry[lid] = outFirstEntry;
    s_entryCount[lid] = outEntryCount;
    s_sectionQuads[lid] = outQuads;
    s_meshlets[lid] = outMeshlets;
    barrier();

    if (lid == 0u) {
        uint outCount = 0u;
        uint totalMeshlets = 0u;
        for (uint i = 0u; i < TASK_WORKGROUP_SIZE; i++) {
            if (s_survives[i] != 0u) {
                totalMeshlets += s_meshlets[i];
                celtiumPayload.meshletEnd[outCount] = totalMeshlets;
                celtiumPayload.frameIndex[outCount] = s_frameIndex[i];
                celtiumPayload.firstEntry[outCount] = s_firstEntry[i];
                celtiumPayload.entryCount[outCount] = s_entryCount[i];
                celtiumPayload.sectionQuads[outCount] = s_sectionQuads[i];
                outCount++;
            }
        }
        celtiumPayload.sectionCount = outCount;
        s_totalMeshlets = totalMeshlets;
    }
    barrier();

    // Uniform control flow across all 32 lanes: a fully culled tile emits zero mesh workgroups.
    EmitMeshTasksEXT(s_totalMeshlets, 1u, 1u);
}
